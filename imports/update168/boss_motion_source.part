class_name TitanBossMotion
extends Node3D
# Update 42: cosmetic animation only; does not change damage, HP or cooldowns.
var boss: Node3D
var element_id: int = 0
var fusion: bool = false
var enraged: bool = false
var elapsed: float = 0.0
var windup_remaining: float = 0.0
var strike_remaining: float = 0.0
var recoil_remaining: float = 0.0
var strike_duration: float = 0.36
# Update 137: element-specific visual pacing (combat timing is unchanged).
const STRIKE_VISUAL_DURATIONS: Array[float] = [0.43, 0.37, 0.58, 0.42, 0.35, 0.40, 0.29, 0.51, 0.25, 0.34]
const IDLE_MOTION_SPEEDS: Array[float] = [1.30, 1.05, 0.68, 0.92, 1.18, 0.88, 1.85, 0.75, 2.20, 1.45]
var recoil_duration: float = 0.24
var recoil_strength: float = 1.0
var recoil_side: float = 1.0
var recoil_hit_count: int = 0
# Update 82: element-specific windup timing and attack silhouettes.
var windup_duration: float = 0.42
var parts: Array[MeshInstance3D] = []
var base_positions: Array[Vector3] = []
var base_rotations: Array[Vector3] = []
var base_scales: Array[Vector3] = []
# Update 131: reusable elemental warning ring (visual only).
var warning_ring: MeshInstance3D
var warning_material: StandardMaterial3D
# Update 132: pooled impact flash and expanding elemental release ring.
var release_ring: MeshInstance3D
var release_material: StandardMaterial3D
var release_core: MeshInstance3D
var release_core_material: StandardMaterial3D
var release_time: float = 0.0
const RELEASE_DURATION: float = 0.42
# Update 133: pooled geometry with genuinely different elemental silhouettes.
var elemental_shards: Array[MeshInstance3D] = []
var shard_origins: Array[Vector3] = []
const SHARD_COUNT: int = 8
const WARNING_COLORS: Array[Color] = [
 Color(1.0, 0.29, 0.10), Color(0.12, 0.65, 1.0),
 Color(0.72, 0.52, 0.24), Color(0.25, 0.90, 0.37),
 Color(1.0, 0.88, 0.30), Color(0.56, 0.24, 0.85),
 Color(0.38, 0.92, 0.96), Color(0.52, 0.87, 1.0),
 Color(1.0, 0.84, 0.12), Color(0.95, 0.25, 0.88)
]

func configure(target: Node3D, element: int, is_fusion: bool) -> void:
 boss = target
 element_id = element
 fusion = is_fusion
 _create_warning_ring()
 _create_release_effect()
 _create_elemental_shards()
 # Capture a few top-level decorative meshes; no collision or physics changed.
 for child in boss.get_children():
  if child is MeshInstance3D and parts.size() < 12:
   parts.append(child)
   base_positions.append(child.position)
   base_rotations.append(child.rotation)
   base_scales.append(child.scale)

func _create_warning_ring() -> void:
 if warning_ring != null:
  return
 warning_ring = MeshInstance3D.new()
 warning_ring.name = "ElementalAttackWarning"
 var ring_mesh := TorusMesh.new()
 ring_mesh.inner_radius = 1.52 if fusion else 1.15
 ring_mesh.outer_radius = 1.65 if fusion else 1.26
 ring_mesh.rings = 12
 ring_mesh.ring_segments = 40
 warning_ring.mesh = ring_mesh
 warning_material = StandardMaterial3D.new()
 warning_material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
 warning_material.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
 warning_material.cull_mode = BaseMaterial3D.CULL_DISABLED
 warning_material.albedo_color = WARNING_COLORS[clampi(element_id, 0, 9)]
 warning_ring.material_override = warning_material
 warning_ring.position = Vector3(0.0, 0.10, 0.0)
 warning_ring.visible = false
 add_child(warning_ring)

func _create_release_effect() -> void:
 if release_ring != null:
  return
 release_ring = MeshInstance3D.new()
 release_ring.name = "ElementalReleaseRing"
 var mesh := TorusMesh.new()
 mesh.inner_radius = 0.70 if fusion else 0.52
 mesh.outer_radius = 0.85 if fusion else 0.65
 mesh.rings = 8
 mesh.ring_segments = 28
 release_ring.mesh = mesh
 release_material = StandardMaterial3D.new()
 release_material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
 release_material.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
 release_material.cull_mode = BaseMaterial3D.CULL_DISABLED
 release_material.albedo_color = WARNING_COLORS[clampi(element_id, 0, 9)]
 release_ring.material_override = release_material
 release_ring.position = Vector3(0.0, 0.18, 0.0)
 release_ring.visible = false
 add_child(release_ring)
 release_core = MeshInstance3D.new()
 release_core.name = "ElementalReleaseFlash"
 var flash_mesh := SphereMesh.new()
 flash_mesh.radius = 0.35 if fusion else 0.27
 flash_mesh.height = 0.70 if fusion else 0.54
 flash_mesh.radial_segments = 12
 flash_mesh.rings = 6
 release_core.mesh = flash_mesh
 release_core_material = StandardMaterial3D.new()
 release_core_material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
 release_core_material.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
 release_core_material.albedo_color = WARNING_COLORS[clampi(element_id, 0, 9)]
 release_core.material_override = release_core_material
 release_core.position = Vector3(0.0, 1.6 if fusion else 1.3, 0.0)
 release_core.visible = false
 add_child(release_core)

func _create_elemental_shards() -> void:
 if not elemental_shards.is_empty():
  return
 for i in range(SHARD_COUNT):
  var shard := MeshInstance3D.new()
  shard.name = "ElementalShard_%02d" % i
  var mat := StandardMaterial3D.new()
  mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
  mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
  mat.cull_mode = BaseMaterial3D.CULL_DISABLED
  mat.albedo_color = WARNING_COLORS[clampi(element_id, 0, 9)]
  shard.material_override = mat
  if element_id == 0: # Fire: rising tongues of flame.
   var flame := SphereMesh.new()
   flame.radius = 0.13
   flame.height = 0.55
   flame.radial_segments = 8
   flame.rings = 4
   shard.mesh = flame
  elif element_id == 8: # Lightning: angular zig-zag flashes.
   var bolt := BoxMesh.new()
   bolt.size = Vector3(0.10, 0.55, 0.10)
   shard.mesh = bolt
  elif element_id == 7: # Ice: long crystalline spikes.
   var ice := CylinderMesh.new()
   ice.top_radius = 0.0
   ice.bottom_radius = 0.15
   ice.height = 0.70
   ice.radial_segments = 5
   shard.mesh = ice
  elif element_id == 1: # Water: rounded splashes.
   var water := SphereMesh.new()
   water.radius = 0.17
   water.height = 0.38
   water.radial_segments = 8
   shard.mesh = water
  elif element_id == 2: # Earth: rough flying stone fragments.
   var stone := BoxMesh.new()
   stone.size = Vector3(0.30, 0.26, 0.25)
   shard.mesh = stone
  elif element_id == 3: # Nature: long leaf shapes.
   var leaf := SphereMesh.new()
   leaf.radius = 0.10
   leaf.height = 0.48
   leaf.radial_segments = 6
   shard.mesh = leaf
  elif element_id == 4: # Light: radiant narrow rays.
   var ray := BoxMesh.new()
   ray.size = Vector3(0.08, 0.62, 0.08)
   shard.mesh = ray
  elif element_id == 5: # Shadow: drifting dark wisps.
   var wisp := SphereMesh.new()
   wisp.radius = 0.16
   wisp.height = 0.52
   wisp.radial_segments = 7
   shard.mesh = wisp
  elif element_id == 6: # Wind: slim spiralling streaks.
   var gust := BoxMesh.new()
   gust.size = Vector3(0.07, 0.08, 0.65)
   shard.mesh = gust
  elif element_id == 9: # Chaos: unstable angular fragments.
   var chaos := BoxMesh.new()
   chaos.size = Vector3(0.24, 0.42, 0.15)
   shard.mesh = chaos
  else:
   var mote := SphereMesh.new()
   mote.radius = 0.12
   mote.height = 0.24
   mote.radial_segments = 8
   mote.rings = 4
   shard.mesh = mote
  var angle: float = TAU * float(i) / float(SHARD_COUNT)
  var start := Vector3(cos(angle) * 0.55, 0.25, sin(angle) * 0.55)
  shard_origins.append(start)
  shard.position = start
  shard.visible = false
  add_child(shard)
  elemental_shards.append(shard)

func set_enraged(value: bool) -> void:
 enraged = value

func attack_windup() -> void:
 windup_duration = [0.48, 0.40, 0.56, 0.44, 0.36, 0.42, 0.32, 0.50, 0.26, 0.38][clampi(element_id, 0, 9)]
 windup_remaining = windup_duration
 if warning_ring != null:
  warning_ring.visible = true
  warning_ring.scale = Vector3.ONE

func attack_release() -> void:
 release_time = RELEASE_DURATION
 strike_duration = STRIKE_VISUAL_DURATIONS[clampi(element_id, 0, 9)] * (1.12 if fusion else 1.0)
 strike_remaining = strike_duration
 windup_remaining = 0.0
 if warning_ring != null:
  warning_ring.visible = false
 if release_ring != null:
  release_ring.visible = true
  release_ring.scale = Vector3.ONE
 if release_core != null:
  release_core.visible = true
  release_core.scale = Vector3.ONE
 for shard in elemental_shards:
  shard.visible = true

func react_to_hit(critical: bool = false) -> void:
 # A critical strike is easier to read, without changing combat calculations.
 recoil_hit_count += 1
 recoil_side = -1.0 if recoil_hit_count % 2 == 0 else 1.0
 recoil_strength = (1.65 if critical else 1.0) * (0.80 if fusion else 1.0)
 recoil_duration = 0.34 if critical else 0.24
 recoil_remaining = recoil_duration

func _process(delta: float) -> void:
 if not is_instance_valid(boss):
  return
 elapsed += delta
 windup_remaining = maxf(0.0, windup_remaining - delta)
 strike_remaining = maxf(0.0, strike_remaining - delta)
 recoil_remaining = maxf(0.0, recoil_remaining - delta)
 release_time = maxf(0.0, release_time - delta)
 if release_ring != null:
  release_ring.visible = release_time > 0.0
  if release_ring.visible:
   var phase: float = 1.0 - release_time / RELEASE_DURATION
   var spread: float = 1.0 + phase * (3.1 if fusion else 2.5)
   release_ring.scale = Vector3(spread, 1.0, spread)
   var ring_tint: Color = WARNING_COLORS[clampi(element_id, 0, 9)]
   ring_tint.a = (1.0 - phase) * 0.85
   release_material.albedo_color = ring_tint
 if release_core != null:
  release_core.visible = release_time > 0.0
  if release_core.visible:
   var flash_phase: float = 1.0 - release_time / RELEASE_DURATION
   release_core.scale = Vector3.ONE * (1.0 + flash_phase * 1.2)
   var flash_tint: Color = WARNING_COLORS[clampi(element_id, 0, 9)].lightened(0.35)
   flash_tint.a = pow(1.0 - flash_phase, 2.0) * 0.75
   release_core_material.albedo_color = flash_tint
 # Update 133: visually distinct, time-bound impact shapes (no combat changes).
 for i in range(elemental_shards.size()):
  var shard: MeshInstance3D = elemental_shards[i]
  shard.visible = release_time > 0.0
  if not shard.visible:
   continue
  var t: float = clampf(1.0 - release_time / RELEASE_DURATION, 0.0, 1.0)
  var angle: float = TAU * float(i) / float(SHARD_COUNT)
  var radial := Vector3(cos(angle), 0.0, sin(angle))
  var origin: Vector3 = shard_origins[i]
  match element_id:
   0: # Flames leap upwards while spreading.
    shard.position = origin + radial * (t * 1.0) + Vector3(0.0, t * (1.6 + float(i % 3) * 0.25), 0.0)
    shard.scale = Vector3(1.0 - t * 0.65, 1.0 + t * 1.2, 1.0 - t * 0.65)
   8: # Lightning flashes dart outward and alternate their angle.
    shard.position = origin + radial * (t * 2.2) + Vector3(0.0, sin(t * TAU * 4.0 + float(i)) * 0.18, 0.0)
    shard.rotation.z = (0.65 if i % 2 == 0 else -0.65) + t * 0.3
    shard.scale = Vector3(1.0 - t * 0.5, 1.0, 1.0)
   7: # Ice crystals erupt and remain upright.
    shard.position = origin + radial * (t * 1.5) + Vector3(0.0, t * 0.65, 0.0)
    shard.scale = Vector3(1.0 - t * 0.3, 1.0 + t * 0.8, 1.0 - t * 0.3)
   1: # Water: droplets arc up, then fall away.
    shard.position = origin + radial * (t * 1.65) + Vector3(0.0, sin(t * PI) * (0.85 + float(i % 3) * 0.12), 0.0)
    shard.scale = Vector3.ONE * (1.0 - t * 0.55)
   2: # Earth: chunks burst outward and tumble.
    shard.position = origin + radial * (t * 1.45) + Vector3(0.0, sin(t * PI) * 0.45, 0.0)
    shard.rotation = Vector3(t * (2.0 + float(i % 3)), t * 2.8, t * 1.5)
    shard.scale = Vector3.ONE * (1.0 - t * 0.45)
   3: # Nature: leaves spiral upward.
    var leaf_angle: float = angle + t * 2.5
    shard.position = Vector3(cos(leaf_angle) * (0.55 + t * 1.25), 0.25 + t * 1.15, sin(leaf_angle) * (0.55 + t * 1.25))
    shard.rotation.z = t * 3.0 + angle
    shard.scale = Vector3.ONE * (1.0 - t * 0.65)
   4: # Light: rays shoot out in a straight burst.
    shard.position = origin + radial * (t * 2.15) + Vector3(0.0, t * 0.22, 0.0)
    shard.rotation.z = angle
    shard.scale = Vector3(0.7, 1.0 + t * 1.2, 0.7)
   5: # Shadow: wisps rise and contract inward.
    shard.position = origin + radial * (sin(t * PI) * 0.9) + Vector3(0.0, t * 1.45, 0.0)
    shard.rotation.y = t * 4.0 + angle
    shard.scale = Vector3.ONE * (1.0 - t * 0.7)
   6: # Wind: streaks orbit rapidly while expanding.
    var gust_angle: float = angle + t * 5.5
    shard.position = Vector3(cos(gust_angle) * (0.55 + t * 1.75), 0.25 + sin(t * PI) * 0.35, sin(gust_angle) * (0.55 + t * 1.75))
    shard.rotation.y = gust_angle
    shard.scale = Vector3.ONE * (1.0 - t * 0.65)
   9: # Chaos: unpredictable alternating trajectories.
    var chaos_direction: float = -1.0 if i % 2 == 0 else 1.0
    shard.position = origin + radial * (t * (1.1 + float(i % 3) * 0.4)) + Vector3(sin(t * 13.0 + float(i)) * t * 0.45, sin(t * 9.0 + float(i)) * 0.6, chaos_direction * t * 0.35)
    shard.rotation = Vector3(t * 7.0, t * chaos_direction * 8.0, t * 5.0)
    shard.scale = Vector3.ONE * (1.0 - t * 0.6)
   _:
    shard.position = origin + radial * (t * 1.7)
    shard.scale = Vector3.ONE * (1.0 - t * 0.8)
  var shard_tint: Color = WARNING_COLORS[clampi(element_id, 0, 9)]
  shard_tint.a = (1.0 - t) * 0.85
  var shard_mat: StandardMaterial3D = shard.material_override as StandardMaterial3D
  shard_mat.albedo_color = shard_tint
 if warning_ring != null:
  warning_ring.visible = windup_remaining > 0.0
  if warning_ring.visible:
   var progress: float = clampf(1.0 - windup_remaining / maxf(windup_duration, 0.01), 0.0, 1.0)
   var pulse: float = 1.0 + 0.10 * sin(progress * TAU * 3.0)
   warning_ring.scale = Vector3(pulse, 1.0, pulse)
   var tint: Color = WARNING_COLORS[clampi(element_id, 0, 9)]
   tint.a = 0.30 + progress * 0.65
   warning_material.albedo_color = tint
 var energy: float = 1.55 if enraged else 1.0
 var amplitude: float = 0.07 * energy * (1.3 if fusion else 1.0)
 var motion_speed: float = IDLE_MOTION_SPEEDS[clampi(element_id, 0, 9)] * (0.82 if fusion else 1.0)
 for i in range(parts.size()):
  var part: MeshInstance3D = parts[i]
  if not is_instance_valid(part):
   continue
  var offset: float = elapsed * motion_speed + float(i) * 0.65
  part.position = base_positions[i] + Vector3(0, sin(offset) * amplitude, 0)
  part.rotation = base_rotations[i]
  # Different animation signatures: stone bosses sway slowly, wind and
  # lightning bosses twitch faster; other elements use a steady pulse.
  var sway: float = 0.025 if element_id == 2 else (0.085 if element_id == 6 or element_id == 8 else 0.045)
  if i % 3 == 0:
   part.rotation.z += sin(offset) * sway * energy
  # Earth carries its weight low; wind floats and lightning jitters.
  if element_id == 2:
   part.position.y -= 0.035
  elif element_id == 6:
   part.position.y += sin(elapsed * 2.8 + float(i) * 0.4) * 0.065
   part.rotation.y += sin(elapsed * 1.9 + float(i)) * 0.045
  elif element_id == 8:
   part.position.x += sin(elapsed * 10.0 + float(i) * 2.0) * 0.025
  part.scale = base_scales[i]
  if windup_remaining > 0.0:
